# 首页（home）的静态 Worker 配置模板。这里没有任何 API 逻辑，只托管构建产物
# 与脚本本体，使安装链接可从直接访问的域名打开。
#
# 准备：cp site/wrangler.home.toml.example site/wrangler.home.toml   # 填入你自己的域名
#       cp site/config.example.json site/config.json                # 填入你自己的地址
# 部署：npm run site:deploy:home   （会先执行 site:build）
#
# 静态资源请求免费（不会执行 Worker 脚本），因此不占用 API Worker 的请求配额。
name = "watch-party-home"
compatibility_date = "2026-06-30"

# TOML 语法：顶层键必须写在任何 [table] 之前。若把 routes 放到 [assets] 之后，
# 它会被当成 [assets] 的字段并被静默丢弃，域名就绑不上。
#
# `wrangler deploy` 会自动创建 DNS 记录与证书（域名所在 zone 在同一账号内）。
routes = [
  { pattern = "home.example.com", custom_domain = true }
]

[assets]
directory = "./dist/home"
# 未知路径一律返回首页，而不是裸 404。
not_found_handling = "single-page-application"
